%% ----------------------------------------------------------------------------
%% 2. Universal Ikasan Flow Component Pipeline
%% ----------------------------------------------------------------------------
flowchart LR
    subgraph IKASAN_FLOW ["Universal Ikasan Flow Lifecycle"]
        CONSUMER["1. Consumer\n(Single Ingress Endpoint:\nREST / Quartz / Kafka / JMS)"]
        --> CONVERTER["2. Converter\n(Format Transformation:\nJSON / XML / Protobuf)"]
        --> TRANSLATOR["3. Translator\n(Enrichment / Validation / Headers)"]
        --> BROKER["4. Broker\n(Sync Lookup / DB Access)"]
        --> SPLITTER["5. Splitter\n(Batch Partitioning)"]
        --> PROCESSOR["6. Processor\n(Domain Business Rules / AI Audit)"]
        --> ROUTER{"7. Router\n(Decision Branching)"}
        ROUTER -->|PASS / NORMAL| PRODUCER1["8a. Producer / Endpoint\n(Outbound Kafka / REST / DB)"]
        ROUTER -->|REVIEW / BREAK| PRODUCER2["8b. Investigation Producer\n(DLQ / Manual Review Queue)"]
    end

%% ----------------------------------------------------------------------------
%% 3. Platform Capability Pack (EFE Core Subsystems)
%% ----------------------------------------------------------------------------
graph TB
    subgraph PLATFORM_CAPABILITIES ["EFE Platform Capability Pack"]
        subgraph INGRESS_LAYER ["Multi-Protocol Ingress Adapters"]
            REST_API["REST API\nPOST /api/v1/jobs\nGET /api/v1/jobs/{id}"]
            GRPC_API["gRPC Adapter\nSubmitJob / GetJob"]
            GRAPHQL_API["GraphQL Controller\njob, tasks, results, submitJob"]
        end

        subgraph ORCHESTRATION_LAYER ["Flow Engine & Execution"]
            IKASAN_ENGINE["Ikasan 5.0.x Engine\nModuleBuilder / FlowBuilder"]
            WORKER_POOL["EfeExecutorService\n(Bounded ArrayBlockingQueue,\nCore: 4, Max: 10, Q: 100)"]
            SCHEDULER["Quartz Scheduled Consumer\n(Interval / Cron / Calendar)"]
        end

        subgraph MANAGEMENT_LAYER ["Operational Visibility & JMX (com.efe)"]
            JMX_MODULE["EfeModuleMBean\n(Status, Flows, Start/Stop)"]
            JMX_EXEC["EfeExecutorMBean\n(Active, Pool, Queue, Tasks)"]
            JMX_SCHED["EfeSchedulerMBean\n(Interval, Next/Last Execution)"]
            JMX_MSG["EfeMessagingMBean\n(Queue Depth, Capacity)"]
        end

        subgraph STORAGE_TRANSPORT ["Persistence & Transport SPIs"]
            DB_BROKER["H2 / SQL Database Broker\n(Job, Task, Result CRUD)"]
            MSG_SPI["Messaging SPI\n(In-Memory / Kafka / JMS / Redis)"]
        end

        subgraph AI_PLUGIN ["Optional Local AI Layer"]
            AI_ROUTER["Intelligence Router Broker"]
            OLLAMA["Ollama Client (Local Model)"]
            RULES["Local Anomaly & Fraud Rules"]
            SANITIZER["PII Data Sanitizer (Masking)"]
            AGGREGATOR["Intelligence Aggregator"]
        end
    end

    INGRESS_LAYER --> IKASAN_ENGINE
    IKASAN_ENGINE --> WORKER_POOL
    IKASAN_ENGINE --> SCHEDULER
    IKASAN_ENGINE --> DB_BROKER
    IKASAN_ENGINE --> MSG_SPI
    IKASAN_ENGINE --> AI_ROUTER
    AI_ROUTER --> SANITIZER
    SANITIZER --> OLLAMA
    SANITIZER --> RULES
    OLLAMA --> AGGREGATOR
    RULES --> AGGREGATOR

%% ----------------------------------------------------------------------------
%% 4. AI-Assisted Ikasan Event Flow & Safe Fallback
%% ----------------------------------------------------------------------------
sequenceDiagram
    autonumber
    participant C as Ikasan Consumer
    participant S as AiDataSanitizer
    participant R as IntelligenceRouter
    participant O as Ollama (Local Model)
    participant F as Fallback / Rules
    participant A as Aggregator
    participant P as Ikasan Producer

    C->>S: Event Payload (contains sensitive fields)
    S->>S: Mask PII (accountId, IBAN, nationalId)
    S->>R: Sanitized IntelligenceRequest
    alt AI Enabled & Ollama Reachable
        R->>O: HTTP POST /api/generate (qwen2.5:3b)
        O-->>R: JSON Response (decision, confidence, reason)
    else AI Disabled or Timeout/Failure
        R->>F: NoOp / Heuristic Error Fallback
        F-->>R: Structured Error Code (AI_TIMEOUT / SKIPPED)
    end
    R->>A: Collect Provider Results
    A->>A: Generate IntelligenceSummary (HOLD / REVIEW / PROCEED)
    A->>P: Enriched Event into Next Ikasan Flow Step
